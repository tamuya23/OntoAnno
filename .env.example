OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=
ONTOANNO_PORT=8501
# Optional default config. You can also pass a config at launch time:
# ./start_ontoanno_docker.sh configs/my_project.yaml
# ./start_ontoanno_apptainer.sh configs/my_project.yaml
ONTOANNO_CONFIG=/app/configs/docker_import_template.yaml
ONTOANNO_IMAGE=docker://ghcr.io/tamuya23/ontoanno:latest
ONTOANNO_APPTAINER_SIF=
# Optional: use a local Cell Ontology file already available inside the container.
# ONTOANNO_CL_OBO=/data/reference/cl.obo
